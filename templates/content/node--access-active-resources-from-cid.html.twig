{#
/**
 * @file
 * Theme override for ACCESS Active Resource (CiDeR) RP documentation page.
 *
 * Renders the full resource provider documentation page with:
 * - ARA recommendation banner (driven by URL params / localStorage)
 * - Resource title with MFA/account badges
 * - Description from field_rp_description
 * - Login section with SSH dropdown + OnDemand login
 * - File transfer table
 * - Storage table with external storage section
 * - Queue specifications table
 * - Most frequently used software table
 * - Datasets section
 * - Sidebar with support links, office hours, software CTAs, chatbot
 *
 * Field data is accessed directly from the node entity for maximum
 * template control. Paragraph fields are iterated for tabular display.
 */
#}
{%
  set classes = [
    'node',
    'node--type-' ~ node.bundle|clean_class,
    node.isPromoted() ? 'node--promoted',
    node.isSticky() ? 'node--sticky',
    not node.isPublished() ? 'node--unpublished',
    view_mode ? 'node--view-mode-' ~ view_mode|clean_class,
    'rp-documentation',
  ]
%}
{{ attach_library('aspTheme/node') }}

{# Three-column software table (Application / Description / Research
   Discipline). Shared by the SDS and OnDemand lists, which differ only in
   where the application name links:
     'sds'      -> the SDS website's software page (top-software behavior)
     'web_page' -> the software's own site (OnDemand behavior)
   Both only link when the entry has a web_page. In 'web_page' mode the value
   is used as the href directly, so it is gated on an http(s) scheme first:
   web_page comes from the SDS feed and from editor-authored OOD JSON, and
   Twig's html autoescaping does not neutralise a javascript:/data: URI in an
   href. An entry whose web_page fails the gate renders as plain text.
   wrapper_class is optional; the SDS call site uses it to make this element
   the scroll box (it has to be the same element as the overflow-x, or the
   sticky header is captured by a nested scroll container). #}
{% macro software_table(rows, link_mode, wrapper_class) %}
  <div class="{{ wrapper_class|default('') }}">
    <table class="w-full border-collapse">
      <thead>
        <tr>
          <th class="text-left py-2 pr-4 font-semibold">Application</th>
          <th class="text-left py-2 pr-4 font-semibold">Description</th>
          <th class="text-left py-2 font-semibold">Research Discipline</th>
        </tr>
      </thead>
      <tbody>
        {% for sw in rows %}
          <tr>
            <td class="py-2 pr-4 font-semibold whitespace-nowrap">
              {%- if sw.web_page and link_mode == 'sds' -%}
                <a href="https://sds.access-ci.org/?software={{ sw.name|replace({' ': '_'})|url_encode }}" class="text-md-teal no-underline hover--underline">{{ sw.name }}</a>
              {%- elseif sw.web_page and sw.web_page matches '#^https?://#i' -%}
                <a href="{{ sw.web_page }}" class="text-md-teal no-underline hover--underline">{{ sw.name }}</a>
              {%- else -%}
                {{ sw.name }}
              {%- endif -%}
            </td>
            <td class="py-2 pr-4 text-sm">{{ sw.description|default('') }}</td>
            <td class="py-2 text-sm">{{ sw.research_field|default('') }}</td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
{% endmacro %}
{% import _self as tpl %}
{% import '@aspTheme/content/rp-fmt.html.twig' as fmt %}

{# Extract field values for easier access in the template #}
{% set rp_description = node.field_rp_description.value %}
{% set mfa_required = node.field_rp_mfa_required.value %}
{% set account_required = node.field_rp_account_required.value %}
{% set ondemand = node.field_rp_ondemand_url.0 %}
{% set ondemand_url = ondemand.url %}
{% set office_hours = node.field_rp_office_hours.0 %}
{% set external_storage = node.field_rp_external_storage.value %}
{% set top_software_json = node.field_rp_top_software.value %}
<article{{ attributes.addClass(classes) }}>

  {# ========== ARA Recommendation Banner ========== #}
  <div id="ara-recommendation-banner" class="bg-primary-blue-bg text-primary-blue border-l-4 border-primary-blue p-4 mb-6 hidden">
    <p class="font-bold mb-1">The ACCESS Resource Advisor recommends this resource for your work.</p>
    <p id="ara-recommendation-text" class="m-0 text-sm"></p>
    <button id="ara-dismiss" class="text-sm underline text-primary-blue mt-2 cursor-pointer bg-transparent border-0 p-0">Dismiss</button>
  </div>

  {# Section-presence gates. Declared at the article level (not inside
     .rp-main-content) because the sticky jump-to nav below sits here too, and
     the full-width Software/Storage/etc. sections further down reuse the same
     flags. #}
  {% set has_login = field_rp_ssh_login_nodes_items|length > 0 or ondemand_url %}
  {% set has_file_transfer = field_rp_file_transfer_items|length > 0 %}
  {% set has_storage = field_rp_storage_items|length > 0 or external_storage %}
  {% set has_jobs = field_rp_queue_specs_items|length > 0 or node.field_rp_jobs_info.value %}
  {# One definition for both the jump-to nav link and the Software section
     itself. They used to be hand-maintained copies of the same condition
     and had drifted: nodes with only an SDS list, only an OnDemand list,
     only a software_list_url or only the sidebar card rendered the
     section with no nav link pointing at it. #}
  {# Slug for the SDS website's ?installed_on= parameter. SDS can only
     filter by group, so prefer the group name SDS itself reports
     (sds_rp_name) and fall back to the one derived from the group title.
     Set once here so the section gate and the sidebar CTA below cannot
     drift apart. #}
  {% set sds_slug = sds_rp_name|default(sds_resource_name) %}
  {% set has_software = top_software|length > 0
    or sds_software|length > 0
    or ood_software|length > 0
    or node.field_rp_software_list_url.0 is not null
    or (sds_has_software and sds_slug) %}
  {% set has_datasets = field_rp_datasets_items|length > 0 %}

  {# account_setup is used by the sidebar CTA; declared here, rendered in Login block at bottom of page #}
  {% set account_setup = node.field_rp_account_setup_url %}

  {# --- Jump-to anchor nav (full-width, sticky) ---
     Lives at the article level, outside .rp-main-content. position:sticky only
     holds within its containing block, and .rp-main-content ends where the top
     grid does — so nesting the nav there let it unstick as soon as the reader
     scrolled into the full-width sections below. At the article level its
     containing block is the whole page, so it stays pinned throughout. #}
  {% if has_login or has_file_transfer or has_storage or has_jobs or has_software or has_datasets %}
    <nav class="rp-jump-to mb-6 py-4 flex flex-wrap items-center gap-x-6 gap-y-2 text-sm" aria-label="Jump to section">
      {% if has_jobs %}
        <a href="#rp-jobs" class="flex items-center gap-1 text-dark-gray no-underline hover--underline font-bold"><i class="bi bi-card-checklist"></i> Submitting Jobs</a>
      {% endif %}
      {% if has_software %}
        <a href="#rp-software" class="flex items-center gap-1 text-dark-gray no-underline hover--underline font-bold"><i class="bi bi-terminal"></i> Software</a>
      {% endif %}
      {% if has_storage %}
        <a href="#rp-storage" class="flex items-center gap-1 text-dark-gray no-underline hover--underline font-bold"><i class="bi bi-database"></i> Storage</a>
      {% endif %}
      {% if has_file_transfer %}
        <a href="#rp-file-transfer" class="flex items-center gap-1 text-dark-gray no-underline hover--underline font-bold"><i class="bi bi-arrow-left-right"></i> File Transfer</a>
      {% endif %}
      {% if has_login %}
        <a href="#rp-login" class="flex items-center gap-1 text-dark-gray no-underline hover--underline font-bold"><i class="bi bi-box-arrow-in-right"></i> Login</a>
      {% endif %}
      {% if has_datasets %}
        <a href="#rp-datasets" class="flex items-center gap-1 text-dark-gray no-underline hover--underline font-bold"><i class="bi bi-table"></i> Datasets</a>
      {% endif %}
    </nav>
  {% endif %}

  <div class="grid grid-cols-1 gap-8 md--grid-cols-[1fr_25%]">

    {# ========== Main Content Column ========== #}
    <div class="rp-main-content">

      {{ title_prefix }}
      {% if account_required %}
        <div class="flex flex-wrap items-center gap-4 mb-4 justify-between">
          <div class="flex gap-4 items-center">
            <span class="flex items-center gap-1 text-sm">
              <i class="bi bi-check-circle-fill text-teal"></i> RP account needed
            </span>
          </div>
        </div>
      {% endif %}
      {{ title_suffix }}

      {# --- Description --- #}
      {% if rp_description %}
        <div class="rp-description prose max-w-none mb-8">
          {{ expandable_text(node.field_rp_description.processed, 3) }}
        </div>
      {% endif %}

      {# --- Embedded Chatbot --- #}
      <div class="rp-chatbot max-w-none mb-8">
        <div class="embedded-qa-bot"
             data-scope-slug="{{ resource_slug }}"
             data-header-title="Ask about {{ resource_display_name }}"
             data-input-placeholder="Ask your questions here"></div>
      </div>

    </div>{# /.rp-main-content #}

    {# ========== Sidebar (top section) ========== #}
    <div class="rp-sidebar">

      {# Support Links #}
      {% set support_links = node.field_rp_support_links %}
      {% if support_links|length > 0 or office_hours %}
        <div class="bg-dark-teal text-white p-4 mb-4">
          <h3 class="mt-0 text-lg font-bold text-white">Get Support</h3>
          {% if support_links|length > 0 %}
            <ul class="list-none p-0 m-0 font-normal">
              {% for link in support_links %}
                <li class="mb-2 pl-0 leading-tight">
                  <a href="{{ link.uri|replace({'internal:': ''}) }}" class="text-white hover--no-underline hover--text-light-teal font-normal leading-tight">
                    {{ link.title ?: link.uri|replace({'internal:': '', 'https://': '', 'http://': ''}) }}
                  </a>
                </li>
              {% endfor %}
            </ul>
          {% endif %}
          {% if office_hours %}
            <div class="border-t border-md-teal pt-3">
              <p class="font-bold mb-1 text-sm">OFFICE HOURS</p>
              <a href="{{ office_hours.uri|replace({'internal:': ''}) }}" class="text-white hover--underline hover--no-underline hover--text-light-teal font-normal text-sm">
                {{ office_hours.title ?: 'View Office Hours' }}
              </a>
            </div>
          {% endif %}
        </div>
      {% endif %}

      {# RP account panel — user-specific. State decision tree:
       - has rows                          → YOUR ACCOUNT panel (data-stale="1" if rows_stale)
       - no_rows_unknown / rows_stale / error (logged in) → loading skeleton (JS refreshes)
       - no_rows_fresh (logged in) OR anonymous → existing GET AN ACCOUNT CTA
      #}
      {% set rp_panel_state = user_rp_accounts_state ?: (logged_in ? 'no_rows_unknown' : 'anon') %}

      {% if user_rp_accounts is defined and user_rp_accounts|length > 0 %}
        {# Don't flag the panel stale while the account is being set up — a
           background refresh would rewrite it from JSON and clobber the
           "being set up" message. #}
        <div class="bg-dark-teal text-white p-4 mb-4 rp-account-panel"
             data-rp-nid="{{ node.id }}"
             {% if rp_panel_state == 'rows_stale' and user_rp_sp_state != 'pending-active' %}data-stale="1"{% endif %}>
          <h3 class="mt-0 text-lg font-bold text-white">YOUR ACCOUNT ON {{ node.label|upper }}</h3>
          {% if user_rp_sp_state == 'pending-active' %}
            {# The RP side is still provisioning the account (sp_state
               pending-active), so hold off on the username and account details
               until it settles. (pending-inactive means the account is being
               deactivated and has account_state inactive, so it never loads
               here — it falls through to normal/no-panel handling.) #}
            <p class="text-sm text-white mb-3">Your account is being set up on {{ node.label }}. Check back soon.</p>
          {% else %}
            {% if user_rp_username %}
              <p class="text-sm text-white mb-3">Username: <strong class="text-white">{{ user_rp_username }}</strong></p>
            {% endif %}

            <div class="rp-account-grants">
              {% for grant in user_rp_accounts %}
                <div class="rp-grant mb-3 pb-3{% if not loop.last %} border-b border-md-teal{% endif %}">
                  <div class="text-sm font-semibold">{{ grant.grant_number }}</div>
                  {% if grant.grant_title %}
                    <div class="text-xs text-light-gray mb-1" title="{{ grant.grant_title }}">
                      {{ grant.grant_title|length > 50 ? grant.grant_title|slice(0, 50) ~ '…' : grant.grant_title }}
                    </div>
                  {% endif %}
                  {% if grant.project_end %}
                    <div class="text-xs">Expires {{ grant.project_end|date('M j, Y') }}</div>
                  {% endif %}
                  <div class="text-xs rp-balance" data-grant="{{ grant.grant_number }}">
                    {% if grant.project_balance is not null and grant.project_balance|trim != '' %}
                      Balance: {{ grant.project_balance|number_format(0) }} {{ grant.billable_unit|default('') }}
                    {% else %}
                      <span class="rp-balance-loading">Loading balance…</span>
                    {% endif %}
                  </div>
                </div>
              {% endfor %}
            </div>

            <a href="https://allocations.access-ci.org/" class="text-white text-sm hover--no-underline hover--text-light-teal">
              Manage allocations →
            </a>
          {% endif %}
        </div>

      {% elseif rp_panel_state in ['no_rows_unknown', 'rows_stale', 'error'] and logged_in %}
        {# DB has no rows but we may not yet have asked. Skeleton with state attr for JS. #}
        <div class="bg-dark-teal text-white p-4 mb-4 rp-account-panel"
             data-rp-nid="{{ node.id }}"
             data-state="{{ rp_panel_state }}">
          <div class="mb-3">
            <h3 class="mt-0 text-lg font-bold text-white">YOUR ACCOUNT ON {{ node.label|upper }}</h3>
            <p class="text-sm">Loading account info…</p>
          </div>
        </div>

      {% elseif rp_panel_state in ['no_rows_fresh', 'anon'] %}
        {# We know there's no account, or the user is anonymous. Show the
           account-setup CTA if the resource has one, else a generic
           allocations CTA (matches the JS no-account fallback). #}
        <div class="bg-dark-teal text-white p-4 mb-4">
          <div class="mb-3">
            <h3 class="mt-0 text-lg font-bold text-white">GET AN ACCOUNT ON {{ node.label|upper }}</h3>
            {% if account_setup|length > 0 %}
              <a href="{{ account_setup.0.uri|replace({'internal:': ''}) }}" class="text-white text-sm no-underline hover--no-underline hover--text-light-teal leading-tight">
                {{ account_setup.0.title ?: 'RP Account Setup' }}
              </a>
            {% else %}
              <a href="https://allocations.access-ci.org/" class="text-white text-sm hover--no-underline hover--text-light-teal leading-tight">
                Request an account
              </a>
            {% endif %}
          </div>
        </div>
      {% endif %}

    </div>{# /.rp-sidebar (top) #}

  </div>{# /.grid (top section) #}

  {# ========== Jobs / Queue Specifications (full width) ========== #}
  {% set jobs_info = node.field_rp_jobs_info.value %}
  {% if field_rp_queue_specs_items|length > 0 or jobs_info %}
    <div id="rp-jobs" class="rp-queue-specs mb-8">
      {# Optional link to the RP's own job submission documentation. #}
      {% set submitting_jobs_link = node.field_rp_submitting_jobs.0 %}
      <div class="flex items-baseline gap-4 flex-wrap">
        <h2 class="flex items-center gap-2"><i class="bi bi-card-checklist"></i>
          Submitting Jobs
          {% if submitting_jobs_link.uri|default('') %}
            <a href="{{ submitting_jobs_link.uri }}" class="no-underline">
              <span class="sr-only">Documentation</span>
              <i class="bi bi-book text-md-teal"></i>
            </a>
          {% endif %}
        </h2>
      </div>
      {% if jobs_info %}
        <div class="prose max-w-none mb-6">
          {{ expandable_text(node.field_rp_jobs_info.processed, 3) }}
        </div>
      {% endif %}
      {# Only render if at least one queue has a name, otherwise the heading
         and column headers show above an empty body. #}
      {# The same pass also flags which optional columns have data in at least
         one row; a column empty across every row is dropped from the table
         entirely rather than rendering a full column of "N/A". Empty
         integer/text fields resolve to [] in Twig, so coerce to scalar first. #}
      {% set has_queue_rows = false %}
      {% set col_cpu = false %}
      {% set col_gpu = false %}
      {% set col_nodes = false %}
      {% set col_ram = false %}
      {% set col_max_wall = false %}
      {% set col_wait = false %}
      {% set col_wall = false %}
      {% set col_jobs = false %}
      {% for paragraph in field_rp_queue_specs_items %}
        {% set qname = paragraph.field_rp_queue_name.value|default('') %}
        {% if qname %}
          {% set has_queue_rows = true %}
          {% set qm = queue_metrics[qname] ?? null %}
          {% set v = paragraph.field_rp_cpus.value %}{% if v is iterable %}{% set v = v|first %}{% endif %}
          {% set n = paragraph.field_rp_cpu_count.value %}{% if n is iterable %}{% set n = n|first %}{% endif %}
          {% if v or (n and n > 0) %}{% set col_cpu = true %}{% endif %}
          {% set v = paragraph.field_rp_gpus.value %}{% if v is iterable %}{% set v = v|first %}{% endif %}
          {% set n = paragraph.field_rp_gpu_vram.value %}{% if n is iterable %}{% set n = n|first %}{% endif %}
          {% set c = paragraph.field_rp_gpu_count.value %}{% if c is iterable %}{% set c = c|first %}{% endif %}
          {% if v or n or (c and c > 0) %}{% set col_gpu = true %}{% endif %}
          {% set v = paragraph.field_rp_node_count.value %}{% if v is iterable %}{% set v = v|first %}{% endif %}
          {% if v is not null and v != '' and v > 0 %}{% set col_nodes = true %}{% endif %}
          {% set v = paragraph.field_rp_vram.value %}{% if v is iterable %}{% set v = v|first %}{% endif %}
          {% if v is not null and v != '' %}{% set col_ram = true %}{% endif %}
          {% set v = paragraph.field_rp_max_wall_time.value %}{% if v is iterable %}{% set v = v|first %}{% endif %}
          {% if v is not empty %}{% set col_max_wall = true %}{% endif %}
          {% if qm and (qm.wait_time is not null or qm.daily_wait|default([])|length > 0) %}{% set col_wait = true %}{% endif %}
          {% if qm and (qm.wall_time is not null or qm.daily_wall|default([])|length > 0) %}{% set col_wall = true %}{% endif %}
          {% if qm and qm.job_count is not null %}{% set col_jobs = true %}{% endif %}
        {% endif %}
      {% endfor %}
      {% if has_queue_rows %}
        <h3>
          Queue specifications
          {# Optional link to the RP's own queue documentation. #}
          {% set queue_spec_link = node.field_rp_queue_spec_link.0 %}
          {% if queue_spec_link.uri|default('') %}
            <a href="{{ queue_spec_link.uri }}" class="no-underline text-dark-teal">
              <span class="sr-only">Documentation</span>
               <i class="bi bi-book text-md-teal"></i>
            </a>
          {% endif %}
        </h3>
          {% if queue_metrics_updated %}
            <p class="text-xs text-dark-gray mb-2">Metrics updated {{ queue_metrics_updated }}</p>
          {% endif %}
          {# Clamp the queue list to N rows with a More/Less toggle. The wrapper
             markup is written out here rather than going through the
             expandable_text() Twig function: that function funnels a captured
             string through #markup, and Xss::filterAdmin() would strip the
             sparkline <svg> and the inline style attributes out of the metric
             cells. data-rows makes the JS clamp on a row boundary. #}
          {{ attach_library('expandable_text/expandable_text') }}
          {# Never cut mid-queue: walk the groups adding each one's row cost —
             1 for a single-row queue, 1 heading + its hardware rows otherwise —
             and stop at the first total that reaches the 4-row target. A total
             that covers every group is emitted anyway; measureRows() then sees
             no overflow and adds no toggle. #}
          {% set clamp_rows = 0 %}
          {% for group in queue_groups %}
            {% if clamp_rows < 4 %}
              {% set clamp_rows = clamp_rows + (group.single ? 1 : 1 + group.rows|length) %}
            {% endif %}
          {% endfor %}
          <div class="expandable-text" data-rows="{{ clamp_rows }}">
          <div class="expandable-text__content" id="rp-queue-specs-content">
          <div>
            <table class="w-full border-collapse">
              <thead>
                <tr>
                  <th class="text-left py-2 pr-4 font-semibold align-bottom">Queue</th>
                  {% if col_cpu %}<th class="text-left py-2 pr-4 font-semibold align-bottom">CPU cores / node</th>{% endif %}
                  {% if col_gpu %}<th class="text-left py-2 pr-4 font-semibold align-bottom">GPUs / node</th>{% endif %}
                  {% if col_nodes %}<th class="text-left py-2 pr-4 font-semibold align-bottom">Num nodes</th>{% endif %}
                  {% if col_ram %}<th class="text-left py-2 pr-4 font-semibold align-bottom">Node RAM</th>{% endif %}
                  {% if col_max_wall %}<th class="text-left py-2 pr-4 font-semibold align-bottom">Max wallclock</th>{% endif %}
                  {% if col_wait %}
                    <th class="text-left py-2 pr-4 font-semibold align-bottom">Wait time
                      <div class="font-normal text-xs text-dark-gray">30-day trend</div>
                    </th>
                  {% endif %}
                  {% if col_wall %}
                    <th class="text-left py-2 pr-4 font-semibold align-bottom">Wall time
                      <div class="font-normal text-xs text-dark-gray">30-day trend</div>
                    </th>
                  {% endif %}
                  {% if col_jobs %}
                    <th class="text-right py-2 font-semibold align-bottom">Number of jobs run
                      <div class="font-normal text-xs text-dark-gray">30 days</div>
                    </th>
                  {% endif %}
                </tr>
              </thead>
              {# One <tbody> per queue. The hardware rows (one per node type) are
                 the paragraphs; the queue-level metrics render once, on the
                 group's heading row, rather than repeating down the group and
                 reading as several independently-measured queues. Grouping is
                 done in QueueSpecGrouper (see aspTheme.theme). #}
              {% set cells = {
                col_cpu: col_cpu,
                col_gpu: col_gpu,
                col_nodes: col_nodes,
                col_ram: col_ram,
                col_max_wall: col_max_wall,
                col_wait: col_wait,
                col_wall: col_wall,
                col_jobs: col_jobs,
              } %}
              {% for group in queue_groups %}
                {% set base = cells|merge({
                  qname: group.name,
                  metrics: group.metrics,
                  limit_min: group.max_wall,
                  idx: loop.index,
                }) %}
                <tbody class="rp-queue-group">
                  {% if group.single %}
                    {# One node type: name, purpose, hardware and metrics all fit
                       on a single row, so the page doesn't grow for the
                       resources (most of them) that never repeat a queue name. #}
                    {% set row = group.rows|first %}
                    <tr class="rp-queue-group__single">
                      <th scope="row" class="text-left py-2 pr-4 font-semibold align-top">
                        {{ group.name }}
                        {% if row.purpose %}<div class="rp-queue-group__purpose">{{ row.purpose }}</div>{% endif %}
                      </th>
                      {% include '@aspTheme/content/rp-queue-cells.html.twig' with base|merge({
                        paragraph: row.paragraph,
                        show_hardware: true,
                        show_metrics: true,
                      }) only %}
                    </tr>
                  {% else %}
                    <tr class="rp-queue-group__heading">
                      <th scope="rowgroup" class="text-left py-2 pr-4 font-semibold align-top">
                        {{ group.name }}
                        {# Only a purpose every row agrees on belongs to the queue;
                           where they differ each hardware row carries its own. #}
                        {% if group.purpose %}<div class="rp-queue-group__purpose">{{ group.purpose }}</div>{% endif %}
                      </th>
                      {% include '@aspTheme/content/rp-queue-cells.html.twig' with base|merge({
                        paragraph: null,
                        show_hardware: false,
                        show_metrics: true,
                      }) only %}
                    </tr>
                    {% for row in group.rows %}
                      <tr class="rp-queue-group__row">
                        {% set row_label = group.purpose is null and row.purpose ? row.purpose : null %}
                        <td class="rp-queue-group__row-label py-2 pr-4 align-top{{ row_label is null ? ' bg-light-gray' }}">
                          {% if row_label %}{{ row_label }}{% endif %}
                        </td>
                        {% include '@aspTheme/content/rp-queue-cells.html.twig' with base|merge({
                          paragraph: row.paragraph,
                          show_hardware: true,
                          show_metrics: false,
                        }) only %}
                      </tr>
                    {% endfor %}
                  {% endif %}
                </tbody>
              {% endfor %}
            </table>
          </div>
          </div>{# /.expandable-text__content #}
          </div>{# /.expandable-text #}
          {% endif %}
        </div>
      {% endif %}

  {# ========== Software (full width) ========== #}
  {% set has_top_software = top_software|length > 0 %}
  {% if has_software %}
    <div id="rp-software" class="rp-top-software mb-8">
      <hr class="rp-section-rule">
      {# Optional link to the RP's own software documentation. #}
      {% set software_link = node.field_rp_software_link.0 %}
      <h2 class="flex items-center gap-2"><i class="bi bi-terminal"></i> Software
        {% if software_link.uri|default('') %}
          <a href="{{ software_link.uri }}" class="no-underline">
            <span class="sr-only">Documentation</span>
            <i class="bi bi-book text-md-teal"></i>
          </a>
        {% endif %}
      </h2>

      <div class="grid grid-cols-1 gap-8 md--grid-cols-[1fr_25%]">

        {# Left column: top-software table + intro #}
        <div class="rp-software-main">
          {% if has_top_software %}
            <div class="rp-top-software-table">
            <p class="text-sm text-dark-gray mb-3">The following software packages are among the most frequently used on {{ node.label }}, based on job data from <a href="https://xdmod.access-ci.org" class="text-md-teal no-underline hover--underline">XDMoD</a>.</p>
            {# Optional link to the RP's own most-used software documentation. #}
            {% set freq_used_software_link = node.field_rp_freq_used_software_link.0 %}
            <h3 class="flex items-center gap-2 font-bold">Most Frequently Used
              {% if freq_used_software_link.uri|default('') %}
                <a href="{{ freq_used_software_link.uri }}" class="no-underline">
                  <span class="sr-only">Documentation</span>
                  <i class="bi bi-book text-md-teal"></i>
                </a>
              {% endif %}
            </h3>
            {# Clamp to N rows with a More/Less toggle. Written out here rather
               than via the expandable_text() Twig function: that function funnels
               a captured string through #markup and Xss::filterAdmin() would
               strip inline markup out of the cells. data-rows makes the JS clamp
               on a row boundary. #}
            {{ attach_library('expandable_text/expandable_text') }}
            <div class="expandable-text" data-rows="5">
            <div class="expandable-text__content" id="rp-top-software-content">
            <div>
              <table class="w-full border-collapse">
                <thead>
                  <tr>
                    <th class="text-left py-2 pr-4 font-semibold">Application</th>
                    <th class="text-left py-2 pr-4 font-semibold">Description</th>
                    <th class="text-left py-2 pr-4 font-semibold">Research Discipline</th>
                    <th class="text-right py-2 font-semibold">Jobs</th>
                  </tr>
                </thead>
                <tbody>
                  {% for software in top_software %}
                    <tr>
                      <td class="py-2 pr-4 font-semibold whitespace-nowrap">
                        {%- if software.web_page -%}
                          <a href="https://sds.access-ci.org/?software={{ software.name|replace({' ': '_'})|url_encode }}" class="text-md-teal no-underline hover--underline">{{ software.name }}</a>
                        {%- else -%}
                          {{ software.name }}
                        {%- endif -%}
                      </td>
                      <td class="py-2 pr-4 text-sm">{{ software.description|default('') }}</td>
                      <td class="py-2 pr-4 text-sm">{{ software.research_field|default('') }}</td>
                      <td class="py-2 text-right whitespace-nowrap">{{ software.job_count|number_format }}</td>
                    </tr>
                  {% endfor %}
                </tbody>
              </table>
            </div>
            </div>{# /.expandable-text__content #}
            </div>{# /.expandable-text #}
            </div>{# /.rp-top-software-table #}
          {% elseif sds_software|length > 0 %}
            {# No XDMoD job data, but SDS reports a catalog for this resource.
               No Jobs column — SDS carries no usage counts. #}
            {{ attach_library('aspTheme/software-table') }}
            <div class="rp-sds-software-table">
            <p class="text-sm text-dark-gray mb-3">The following software is reported as available on {{ node.label }} by the <a href="https://sds.access-ci.org" class="text-md-teal no-underline hover--underline">Software Documentation Service</a>.</p>
            <h3 class="font-bold">Available Software</h3>
            <div class="rp-sds-software" data-total="{{ sds_software|length }}">
              {# Rendered hidden and un-hidden by rp-software-filter.js, so no-JS
                 visitors never see a dead input. #}
              <div class="rp-sds-software__filter-wrap mb-3" hidden>
                <label class="sr-only" for="rp-sds-software-filter">Filter software by name</label>
                <input type="search" id="rp-sds-software-filter" class="rp-sds-software__filter border border-solid border-light-gray px-2 py-1 text-sm w-full" placeholder="Filter by name" autocomplete="off">
              </div>
              {{ tpl.software_table(sds_software, 'sds', 'rp-software-scroll') }}
              <p class="rp-sds-software__empty text-sm text-dark-gray mt-3" hidden>No software matches that name.</p>
              {# Kept in the DOM from first render — injected live regions
                 announce unreliably. #}
              <div class="sr-only" role="status" aria-live="polite"></div>
            </div>
            </div>{# /.rp-sds-software-table #}
          {% else %}
            <p class="text-sm text-dark-gray">No software usage data is currently reported for {{ node.label }} in <a href="https://xdmod.access-ci.org" class="text-md-teal no-underline hover--underline">XDMoD</a>.</p>
          {% endif %}
          {% if ood_software|length > 0 %}
            <div class="rp-ood-software">
            <h3 class="font-bold mt-6">Available via ACCESS OnDemand</h3>
            {# Link to the resource's OnDemand instance (the existing field_rp_ondemand_url, already set up as ondemand_url). #}
            <p class="text-sm text-dark-gray mb-3">Software available through {% if ondemand_url %}<a href="{{ ondemand_url }}" class="text-md-teal no-underline hover--underline">ACCESS OnDemand on {{ node.label }}</a>{% else %}ACCESS OnDemand on {{ node.label }}{% endif %}.</p>
            {{ tpl.software_table(ood_software, 'web_page') }}
            </div>{# /.rp-ood-software #}
          {% endif %}
        </div>

        {# Right column: sidebar CTAs #}
        <div class="rp-software-sidebar">
          {# Software CTA: RP's official software page #}
          {% set software_list_url = node.field_rp_software_list_url.0 %}
          {# sds_slug is set near has_software above. The link text names the
             group rather than implying SDS is filtered to this resource. #}
          {% if software_list_url or sds_has_software and sds_slug %}
            <div class="bg-dark-teal text-white p-4 mb-4">
              <h3 class="mt-0 text-lg font-bold text-white">SEE ALL SOFTWARE AVAILABLE ON {{ node.label|upper }}</h3>
              <ul class="list-none p-0 m-0 font-normal">
                {% if sds_has_software and sds_slug %}
                  <li class="mb-2 pl-0 leading-tight">
                    <a href="https://sds.access-ci.org/?installed_on={{ sds_slug|url_encode }}" class="text-white text-sm hover--no-underline hover--text-light-teal leading-tight">
                      Explore all {{ sds_resource_label|default('ACCESS') }} software in the Software Documentation Service
                    </a>
                  </li>
                {% else %}
                  <li class="mb-2 pl-0">
                    <p class="text-sm text-white m-0">{{ node.label }} is not currently reporting available software to the <a href="https://sds.access-ci.org" class="text-white underline hover--no-underline hover--text-light-teal">Software Documentation Service</a>.</p>
                  </li>
                {% endif %}

                {% if software_list_url %}
                  <li class="mb-2 pl-0 leading-tight">
                    <a href="{{ software_list_url.uri|replace({'internal:': ''}) }}" class="text-white text-sm hover--no-underline hover--text-light-teal leading-tight">
                      See Provider Software Documentation
                    </a>
                  </li>
                {% endif %}
              </ul>
            </div>
          {% endif %}

        </div>

      </div>{# /.grid #}
    </div>
  {% endif %}

  {# ========== Storage (full width, near bottom) ========== #}
  {# --- Storage Section --- #}
  {% if field_rp_storage_items|length > 0 or external_storage %}
    <div id="rp-storage" class="rp-storage mb-8">
      <hr class="rp-section-rule">
      {# Optional link to the RP's own storage documentation. #}
      {% set storage_link = node.field_rp_storage_link.0 %}
      <h2 class="flex items-center gap-2"><i class="bi bi-database"></i> Storage
        {% if storage_link.uri|default('') %}
          <a href="{{ storage_link.uri }}" class="no-underline">
            <span class="sr-only">Documentation</span>
            <i class="bi bi-book text-md-teal"></i>
          </a>
        {% endif %}
      </h2>

      {% set storage_text = node.field_rp_storage_text.value %}
      {% if storage_text %}
        <div class="prose max-w-none mb-4">
          {{ expandable_text(node.field_rp_storage_text.processed, 3) }}
        </div>
      {% endif %}

      {# File System Table — only render if at least one row has a directory,
         otherwise the headers show above an empty body. #}
      {% set has_storage_rows = false %}
      {% for paragraph in field_rp_storage_items %}
        {% if paragraph.field_rp_directory.value|default('') %}
          {% set has_storage_rows = true %}
        {% endif %}
      {% endfor %}
      {% if has_storage_rows %}
        {# Optional link to the RP's own file system documentation. #}
        {% set file_system_link = node.field_rp_file_system_link.0 %}
        <h3 class="flex items-center gap-2 font-bold">File System
          {% if file_system_link.uri|default('') %}
            <a href="{{ file_system_link.uri }}" class="no-underline">
              <span class="sr-only">Documentation</span>
              <i class="bi bi-book text-md-teal"></i>
            </a>
          {% endif %}
        </h3>
        <div>
          <table class="w-full border-collapse">
            <thead>
              <tr>
                <th class="text-left py-2 pr-4 font-semibold">Directory</th>
                <th class="text-left py-2 pr-4 font-semibold">Path</th>
                <th class="text-left py-2 pr-4 font-semibold">Quota</th>
                <th class="text-left py-2 pr-4 font-semibold">Purge</th>
                <th class="text-left py-2 pr-4 font-semibold">Backup</th>
                <th class="text-left py-2 font-semibold">Notes</th>
              </tr>
            </thead>
            <tbody>
              {% for paragraph in field_rp_storage_items %}
                {% if paragraph.field_rp_directory.value|default('') %}
                <tr>
                  <td class="py-2 pr-4 font-semibold">{{ paragraph.field_rp_directory.value|default('') }}</td>
                  <td class="py-2 pr-4">{{ paragraph.field_rp_fs_path.value|default('') }}</td>
                  <td class="py-2 pr-4">
                    {% set quota_inode = paragraph.field_rp_quota_inode_amount.value %}
                    {% set quota_size = fmt.gb_size(paragraph.field_rp_quota_size.value)|trim %}
                    {%- if quota_size or quota_inode -%}
                      {{ quota_size }}{% if quota_inode %}{% if quota_size %}, {% endif %}{{ quota_inode|number_format }} files{% endif %}
                    {%- else -%}
                      See notes
                    {%- endif -%}
                  </td>
                  <td class="py-2 pr-4">{{ paragraph.field_rp_purge.value|default('') }}</td>
                  <td class="py-2 pr-4">{{ paragraph.field_rp_backup.value|default('') }}</td>
                  <td class="py-2">{{ paragraph.field_rp_fs_notes.value|default('') }}</td>
                </tr>
                {% endif %}
              {% endfor %}
            </tbody>
          </table>
        </div>
      {% endif %}

      {# External Storage #}
      {% if external_storage %}
        {# Optional link to the RP's own external storage documentation. #}
        {% set external_storage_link = node.field_rp_external_storage_link.0 %}
        <h3 class="flex items-center gap-2 font-bold mt-6">External Storage
          {% if external_storage_link.uri|default('') %}
            <a href="{{ external_storage_link.uri }}" class="no-underline">
              <span class="sr-only">Documentation</span>
              <i class="bi bi-book text-md-teal"></i>
            </a>
          {% endif %}
        </h3>
        <div class="prose max-w-none mb-8">
          {{ expandable_text(node.field_rp_external_storage.processed, 3) }}
        </div>
      {% endif %}
    </div>
  {% endif %}

  {# ========== File Transfer (full width, near bottom) ========== #}
  {# --- File Transfer Table --- #}
  {% if field_rp_file_transfer_items|length > 0 %}
    <div id="rp-file-transfer" class="rp-file-transfer mb-8">
      <hr class="rp-section-rule">
      {# Optional link to the RP's own file transfer documentation. #}
      {% set file_transfer_link = node.field_rp_file_transfer_link.0 %}
      <h2 class="flex items-center gap-2"><i class="bi bi-arrow-left-right"></i> File Transfer
        {% if file_transfer_link.uri|default('') %}
          <a href="{{ file_transfer_link.uri }}" class="no-underline">
            <span class="sr-only">Documentation</span>
            <i class="bi bi-book text-md-teal"></i>
          </a>
        {% endif %}
      </h2>
      {% set file_transfer_text = node.field_rp_file_transfer_text.value %}
      {% if file_transfer_text %}
        <div class="prose max-w-none mb-4">
          {{ expandable_text(node.field_rp_file_transfer_text.processed, 3) }}
        </div>
      {% endif %}
      {# Only render the table if at least one row has a transfer method,
         otherwise the headers show above an empty body. #}
      {% set has_transfer_rows = false %}
      {% for paragraph in field_rp_file_transfer_items %}
        {% if paragraph.field_rp_method.value|default('') %}
          {% set has_transfer_rows = true %}
        {% endif %}
      {% endfor %}
      {% if has_transfer_rows %}
      {# Clamp to N rows with a More/Less toggle, same as the top-software and
         datasets tables: written out here rather than via the expandable_text()
         Twig function, which funnels a captured string through #markup where
         Xss::filterAdmin() would strip the cell markup. data-rows makes the JS
         clamp on a row boundary. #}
      {{ attach_library('expandable_text/expandable_text') }}
      <div class="expandable-text" data-rows="3">
      <div class="expandable-text__content" id="rp-file-transfer-content">
      <div>
        <table class="w-full border-collapse">
          <thead>
            <tr>
              <th class="text-left py-2 pr-4 font-semibold">Supported Methods</th>
              <th class="text-left py-2 pr-4 font-semibold">Data Transfer Node / Globus Collection</th>
              <th class="text-left py-2 font-semibold">Notes</th>
            </tr>
          </thead>
          <tbody>
            {% for paragraph in field_rp_file_transfer_items %}
              {% if paragraph.field_rp_method.value|default('') %}
              <tr>
                <td class="py-2 pr-4">
                  {{ paragraph.field_rp_method.value|default('')|upper }}
                  {% if paragraph.field_rp_recommended.value %}
                    <span class="text-xs font-bold text-dark-gray">| RECOMMENDED</span>
                  {% endif %}
                </td>
                <td class="py-2 pr-4">{{ paragraph.field_rp_transfer_node.value|default('') }}</td>
                <td class="py-2">
                  {% if paragraph.field_rp_transfer_url.0.uri %}
                    <a href="{{ paragraph.field_rp_transfer_url.0.uri|replace({'internal:': ''}) }}" class="text-md-teal no-underline hover--underline">
                      {{ paragraph.field_rp_transfer_url.0.title ?: paragraph.field_rp_transfer_url.0.uri|replace({'internal:': ''}) }}
                    </a>
                  {% endif %}
                </td>
              </tr>
              {% endif %}
            {% endfor %}
          </tbody>
        </table>
      </div>
      </div>{# /.expandable-text__content #}
      </div>{# /.expandable-text #}
      {% endif %}
    </div>
  {% endif %}

  {# ========== Login (full width, at bottom — the "do this last" CTA) ========== #}
  {# --- Login Section --- #}
  {% set ssh_logins = field_rp_ssh_login_nodes_items %}
  {% set login_text = node.field_rp_login_text.value %}
  {% set login_help = node.field_rp_login_help_links %}
  {% if ssh_logins|length > 0 or ondemand_url or login_text or login_help|length > 0 or account_setup|length > 0 or mfa_required %}
    <div id="rp-login" class="rp-login mb-8">
      <hr class="rp-section-rule">
      {# Optional link to the RP's own login documentation. #}
      {% set login_doc_link = node.field_rp_login_to_anvil_gpu_link.0 %}
      <h2 class="flex items-center gap-2"><i class="bi bi-box-arrow-in-right"></i> Login to {{ node.label }}
        {% if login_doc_link.uri|default('') %}
          <a href="{{ login_doc_link.uri }}" class="no-underline">
            <span class="sr-only">Documentation</span>
            <i class="bi bi-book text-md-teal"></i>
          </a>
        {% endif %}
      </h2>

      {% if mfa_required %}
        <p class="flex items-center gap-1 text-sm mb-4">
          <i class="bi bi-shield-lock-fill text-teal"></i> 2FA/MFA required for login
        </p>
      {% endif %}

      {# Login text — rich text above login boxes #}
      {% if login_text %}
        <div class="prose max-w-none mb-4">
          {{ expandable_text(node.field_rp_login_text.processed, 3) }}
        </div>
      {% endif %}

      {% if ssh_logins|length > 0 or ondemand_url %}
      <div class="grid grid-cols-1 gap-4 md--grid-cols-2">

        {# SSH Login dropdown — uses paragraph with recommended boolean #}
        {% if ssh_logins|length > 0 %}
          {# Build a render-friendly list, preferring the structured fields
             with a fallback to the legacy field_rp_ssh_url for paragraphs
             that haven't been migrated yet. #}
          {% set ssh_entries = [] %}
          {% for login in ssh_logins %}
            {% set hostname = login.field_rp_ssh_hostname.value|default('') %}
            {% set placeholder = login.field_rp_ssh_user_placeholder.value|default('<your_username>') %}
            {% set docs_uri = login.field_rp_ssh_docs_url.0.uri|default('') %}
            {% set docs_title = login.field_rp_ssh_docs_url.0.title|default('') %}
            {% set ssh_entries = ssh_entries|merge([{
              'hostname': hostname,
              'placeholder': placeholder,
              'docs_uri': docs_uri,
              'docs_title': docs_title,
              'recommended': login.field_rp_recommended.value,
            }]) %}
          {% endfor %}

          {% set first_entry = ssh_entries[0] %}
          {% for entry in ssh_entries %}
            {% if entry.recommended %}
              {% set first_entry = entry %}
            {% endif %}
          {% endfor %}

          <div class="border-2 border-dark-teal p-4">
            {# Optional link to the RP's own SSH login documentation. #}
            {% set ssh_login_link = node.field_rp_ssh_login_link.0 %}
            <h3 class="flex items-center gap-2 text-lg font-bold mt-0 mb-3">SSH Login
              {% if ssh_login_link.uri|default('') %}
                <a href="{{ ssh_login_link.uri }}" class="no-underline">
                  <span class="sr-only">Documentation</span>
                  <i class="bi bi-book text-md-teal"></i>
                </a>
              {% endif %}
            </h3>
            {# Only surface the user's real RP username in the ssh command once
               the account is provisioned. While sp_state is pending-active the
               account panel above says "being set up", so don't imply a usable
               login name here — fall back to the generic placeholder. #}
            {% set ssh_username = user_rp_sp_state == 'pending-active' ? '' : user_rp_username|default('') %}
            <label for="rp-ssh-login-select" class="sr-only">SSH login host</label>
            <select id="rp-ssh-login-select" class="w-full border border-gray rounded-md p-2 mb-2" data-placeholder-fallback="&lt;your_username&gt;" data-user-username="{{ ssh_username }}">
              {% for entry in ssh_entries %}
                <option value="{{ entry.hostname }}" data-placeholder="{{ entry.placeholder }}" data-docs-uri="{{ entry.docs_uri }}" data-docs-title="{{ entry.docs_title }}" {{ entry.recommended ? 'selected' : '' }}>
                  {{ entry.hostname }}{% if entry.recommended %} | RECOMMENDED{% endif %}
                </option>
              {% endfor %}
            </select>
            <div class="overflow-x-auto bg-light-gray rounded-md mb-3">
              <code id="rp-ssh-command" class="not-prose block p-2 text-sm whitespace-nowrap">$ ssh <span id="rp-ssh-placeholder">{{ ssh_username ?: first_entry.placeholder }}</span>@<span id="rp-ssh-hostname">{{ first_entry.hostname }}</span></code>
            </div>
            <div id="rp-ssh-docs" class="text-sm{% if not first_entry.docs_uri %} hidden{% endif %}">
              <a id="rp-ssh-docs-link" href="{{ first_entry.docs_uri }}" class="flex items-center gap-1 text-md-teal no-underline hover--underline">
                <i class="bi bi-box-arrow-up-right"></i> <span id="rp-ssh-docs-text">{{ first_entry.docs_title ?: 'Login instructions' }}</span>
              </a>
            </div>
          </div>
        {% endif %}

        {# OnDemand Login #}
        {% if ondemand_url %}
          <div class="border-2 border-dark-teal p-4">
            {# Optional link to the RP's own OnDemand login documentation. #}
            {% set ood_login_link = node.field_rp_access_ood_login_link.0 %}
            <h3 class="flex items-center gap-2 text-lg font-bold mt-0 mb-3">ACCESS OnDemand Login
              {% if ood_login_link.uri|default('') %}
                <a href="{{ ood_login_link.uri }}" class="no-underline">
                  <span class="sr-only">Documentation</span>
                  <i class="bi bi-book text-md-teal"></i>
                </a>
              {% endif %}
            </h3>
            <a href="{{ ondemand_url }}" class="btn btn-primary">
              {{ ondemand.title|default('LOGIN')|upper }}
            </a>
            <div class="mt-3">
              <a href="https://support.access-ci.org/tools/ondemand" class="text-sm text-md-teal no-underline hover--underline flex items-center gap-1">
                <i class="bi bi-box-arrow-up-right"></i> How do I use ACCESS OnDemand?
              </a>
            </div>
          </div>
        {% endif %}
      </div>
      {% endif %}

      {# Login help links #}
      {% if login_help|length > 0 %}
        <div class="flex flex-wrap gap-3 text-sm mt-3">
          {% for link in login_help %}
            <a href="{{ link.uri|replace({'internal:': ''}) }}" class="flex items-center gap-1 text-md-teal no-underline hover--underline">
              <i class="bi bi-play-circle"></i> {{ link.title ?: link.uri|replace({'internal:': '', 'https://': '', 'http://': ''}) }}
            </a>
          {% endfor %}
        </div>
      {% endif %}
    </div>
  {% endif %}
  {# ========== Datasets (full width, at bottom) ========== #}
  {% if field_rp_datasets_items|length > 0 %}
    <div id="rp-datasets" class="rp-datasets mb-8">
      <hr class="rp-section-rule">
      {# Optional link to the RP's own datasets documentation. #}
      {% set datasets_link = node.field_rp_datasets_link.0 %}
      <h2 class="flex items-center gap-2"><i class="bi bi-table"></i> Datasets
        {% if datasets_link.uri|default('') %}
          <a href="{{ datasets_link.uri }}" class="no-underline">
            <span class="sr-only">Documentation</span>
            <i class="bi bi-book text-md-teal"></i>
          </a>
        {% endif %}
      </h2>
      {% set datasets_text = node.field_rp_datasets_text.value %}
      {% if datasets_text %}
        <div class="prose max-w-none mb-4">
          {{ expandable_text(node.field_rp_datasets_text.processed, 3) }}
        </div>
      {% endif %}
      {# Only render the table if at least one row has a name, otherwise the
         headers show above an empty body. #}
      {% set has_dataset_rows = false %}
      {% for paragraph in field_rp_datasets_items %}
        {% if paragraph.field_rp_dataset_name.value|default('') %}
          {% set has_dataset_rows = true %}
        {% endif %}
      {% endfor %}
      {% if has_dataset_rows %}
      {# Clamp to N rows with a More/Less toggle, same as the top-software
         table: written out here rather than via the expandable_text() Twig
         function, which funnels a captured string through #markup where
         Xss::filterAdmin() would strip the cell markup. data-rows makes the JS
         clamp on a row boundary. #}
      {{ attach_library('expandable_text/expandable_text') }}
      <div class="expandable-text" data-rows="2">
      <div class="expandable-text__content" id="rp-datasets-content">
      <div>
        <table class="w-full border-collapse">
          <thead>
            <tr>
              <th class="text-left py-2 pr-4 font-semibold">Name</th>
              <th class="text-left py-2 font-semibold">Description</th>
            </tr>
          </thead>
          <tbody>
            {% for paragraph in field_rp_datasets_items %}
              {% if paragraph.field_rp_dataset_name.value|default('') %}
              <tr>
                <td class="py-2 pr-4 font-semibold">{{ paragraph.field_rp_dataset_name.value }}</td>
                <td class="py-2 text-sm">{{ paragraph.field_rp_dataset_description.value|default('') ? paragraph.field_rp_dataset_description.processed : '' }}</td>
              </tr>
              {% endif %}
            {% endfor %}
          </tbody>
        </table>
      </div>
      </div>{# /.expandable-text__content #}
      </div>{# /.expandable-text #}
      {% endif %}
    </div>
  {% endif %}


</article>

{# ========== ARA Banner JavaScript ========== #}
<script>
(function() {
  var banner = document.getElementById('ara-recommendation-banner');
  var textEl = document.getElementById('ara-recommendation-text');
  var dismissBtn = document.getElementById('ara-dismiss');
  var storageKey = 'ara_recommendation_{{ node.id }}';

  // Check URL params first, then localStorage
  var params = new URLSearchParams(window.location.search);
  var araContext = params.get('ara_context');

  if (araContext) {
    localStorage.setItem(storageKey, araContext);
  } else {
    araContext = localStorage.getItem(storageKey);
  }

  if (araContext) {
    textEl.textContent = araContext;
    banner.classList.remove('hidden');
  }

  if (dismissBtn) {
    dismissBtn.addEventListener('click', function() {
      localStorage.removeItem(storageKey);
      banner.classList.add('hidden');
    });
  }
})();
</script>

{# ========== SSH Login Selector JavaScript ========== #}
<script>
(function() {
  var select = document.getElementById('rp-ssh-login-select');
  var hostnameEl = document.getElementById('rp-ssh-hostname');
  var placeholderEl = document.getElementById('rp-ssh-placeholder');
  var docsContainer = document.getElementById('rp-ssh-docs');
  var docsLink = document.getElementById('rp-ssh-docs-link');
  var docsText = document.getElementById('rp-ssh-docs-text');
  if (!select || !hostnameEl) return;

  var fallback = select.getAttribute('data-placeholder-fallback') || '<your_username>';
  var userUsername = select.getAttribute('data-user-username') || '';

  function apply() {
    var opt = select.options[select.selectedIndex];
    hostnameEl.textContent = opt.value;
    if (placeholderEl) {
      placeholderEl.textContent = userUsername || opt.getAttribute('data-placeholder') || fallback;
    }
    if (docsContainer && docsLink && docsText) {
      var docsUri = opt.getAttribute('data-docs-uri');
      var docsTitle = opt.getAttribute('data-docs-title');
      if (docsUri) {
        docsLink.href = docsUri;
        docsText.textContent = docsTitle || 'Login instructions';
        docsContainer.classList.remove('hidden');
      } else {
        docsContainer.classList.add('hidden');
      }
    }
  }

  select.addEventListener('change', apply);
})();
</script>

